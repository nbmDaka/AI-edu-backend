DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,backend,aiedu.com.kz
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://aiedu.com.kz
# Production: DEBUG=false and CSRF_TRUSTED_ORIGINS=https://aiedu.com.kz
DATABASE_NAME=aiedu
DATABASE_USER=aiedu
DATABASE_PASSWORD=replace-with-random-password
# Production PostgreSQL endpoint for external clients.
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_PUBLISHED_PORT=5432
S3_BUCKET=aiedu
S3_ACCESS_KEY=replace-with-random-access-key
S3_SECRET_KEY=replace-with-random-secret-key
MAX_IMAGE_BYTES=10485760

# Account emails via Resend. Verify aiedu.com.kz in Resend before sending.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=AI Edu <noreply@aiedu.com.kz>
PUBLIC_SITE_URL=https://aiedu.com.kz
EMAIL_BACKEND=common.email.ResendEmailBackend
EMAIL_TIMEOUT=10
PASSWORD_RESET_TIMEOUT=3600
EMAIL_VERIFICATION_TIMEOUT=86400

# Internal address of our existing AI gateway. Never expose its key in frontend variables.
AI_SERVICE_URL=http://ai-tutor:3001
AI_SERVICE_API_KEY=replace-with-the-AI-gateway-API_SHARED_KEY
AI_SERVICE_TIMEOUT=90
AI_TUTOR_RATE=20/min
# Local loopback with DEBUG, or explicitly enabled private cloud pilot. Never enable DEBUG in production.
AI_AVATAR_SERVICE_URL=
AI_AVATAR_ENABLED=0
AI_AVATAR_ALLOWED_USERS=
AI_AVATAR_EXPIRES_AT=0
AI_AVATAR_MODEL_KEY=
AI_AVATAR_MODEL_VERSION=
# OpenAI-compatible Chat Completions endpoint; example: https://provider.example/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=120

# Lecture import worker: DOCX/PPTX native structure, PDF layout + OCR.
LECTURE_IMPORT_MAX_BYTES=10485760
LECTURE_IMPORT_MAX_PAGES=100
LECTURE_IMPORT_TIMEOUT=900
LECTURE_IMPORT_OCR_LANGUAGES=rus+eng+kaz
