OPENAI_API_KEY=replace-with-server-key
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_DB_PROVIDER=postgres
DATABASE_URL=postgresql://ai_user:replace-with-password@localhost:5432/ai_tutor?schema=public
API_SHARED_KEY=replace-with-random-service-key
API_CORS_ORIGINS=http://localhost
API_CORS_ALLOW_CREDENTIALS=false
AI_MAX_INPUT_CHARS=6000
AI_MAX_HISTORY_MESSAGES=12
AI_RPM_LIMIT=30
AI_DAILY_REQUEST_LIMIT=500
AI_DAILY_TOKEN_LIMIT=750000
AI_MONTHLY_COST_USD_LIMIT=100
AI_REDIS_ENABLED=false
LOCAL_TTS_URL=http://127.0.0.1:8002/synthesize
TTS_TIMEOUT_MS=90000
LOCAL_STT_URL=http://127.0.0.1:8001/transcribe
STT_TIMEOUT_MS=30000
PIPER_EXE=/opt/ai/piper/piper
PIPER_MODEL_RU=/opt/ai/piper/ru_RU-denis-medium.onnx
PIPER_LENGTH_SCALE=1.04
